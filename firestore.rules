rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(boardId, memberUid) {
      return /databases/$(database)/documents/boards/$(boardId)/members/$(memberUid);
    }

    function boardPath(boardId) {
      return /databases/$(database)/documents/boards/$(boardId);
    }

    function invitationPath(boardId, email) {
      return /databases/$(database)/documents/boards/$(boardId)/invitations/$(email);
    }

    function isMember(boardId, memberUid) {
      return signedIn() && exists(memberPath(boardId, memberUid));
    }

    function isBoardMember(boardId) {
      return isMember(boardId, request.auth.uid);
    }

    function hasRole(boardId, roles) {
      return isBoardMember(boardId) && get(memberPath(boardId, request.auth.uid)).data.role in roles;
    }

    function canEdit(boardId) {
      return hasRole(boardId, ['owner', 'admin', 'editor']);
    }

    function isAdmin(boardId) {
      return hasRole(boardId, ['owner', 'admin']);
    }

    function canInvite(boardId, role) {
      return isAdmin(boardId) && role in ['owner', 'editor', 'reader']
        || hasRole(boardId, ['editor']) && role in ['editor', 'reader'];
    }

    function validInvitation(boardId, email, data) {
      return canInvite(boardId, data.role)
        && data.keys().hasOnly(['email', 'role', 'invitedBy', 'inviterName', 'createdAt', 'acceptedBy', 'acceptedAt'])
        && data.email == email
        && data.invitedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.acceptedBy == null
        && data.acceptedAt == null;
    }

    function hasAcceptedInvitation(boardId, email, role) {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == email
        && exists(invitationPath(boardId, email))
        && getAfter(invitationPath(boardId, email)).data.role == role
        && getAfter(invitationPath(boardId, email)).data.acceptedBy == request.auth.uid;
    }

    function validTask(boardId, taskId, data) {
      return data.keys().hasAll(['id', 'title', 'description', 'status', 'priority', 'assigneeUid', 'dueDate', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'description', 'status', 'priority', 'assigneeUid', 'dueDate', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.id == taskId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 500
        && data.status in ['todo', 'doing', 'done']
        && data.priority in ['low', 'normal', 'high']
        && (data.assigneeUid == null || isMember(boardId, data.assigneeUid))
        && (data.dueDate == null || data.dueDate is string && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.createdBy is string
        && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /boards/{boardId} {
      allow get: if signedIn();
      allow list: if isBoardMember(boardId);
      allow create: if signedIn()
        && boardId == 'quadro-principal'
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && existsAfter(memberPath(boardId, request.auth.uid))
        && getAfter(memberPath(boardId, request.auth.uid)).data.role == 'owner';
      allow update: if isAdmin(boardId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']);
      allow delete: if isAdmin(boardId);

      match /members/{memberUid} {
        allow get: if signedIn() && (isBoardMember(boardId) || memberUid == request.auth.uid);
        allow list: if isBoardMember(boardId);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'displayName', 'handle', 'photoURL', 'joinedAt'])
          && request.resource.data.uid == memberUid
          && request.resource.data.email is string
          && request.resource.data.displayName is string
          && request.resource.data.handle is string
          && (isAdmin(boardId) && request.resource.data.role in ['owner', 'reader', 'editor']
            || memberUid == request.auth.uid && request.resource.data.role == 'owner'
              && request.resource.data.email == request.auth.token.email
              && existsAfter(boardPath(boardId))
              && getAfter(boardPath(boardId)).data.createdBy == request.auth.uid
            || memberUid == request.auth.uid
              && request.resource.data.email == request.auth.token.email
              && hasAcceptedInvitation(boardId, request.auth.token.email, request.resource.data.role));
        allow update: if signedIn() && (
          isAdmin(boardId) && memberUid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role in ['owner', 'reader', 'editor']
          || memberUid == request.auth.uid && isBoardMember(boardId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'handle', 'photoURL'])
          || memberUid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'email', 'displayName', 'handle', 'photoURL'])
            && hasAcceptedInvitation(boardId, request.auth.token.email, request.resource.data.role)
        );
        allow delete: if isAdmin(boardId) && memberUid != request.auth.uid;
      }

      match /invitations/{email} {
        allow get: if isAdmin(boardId)
          || signedIn() && email == request.auth.token.email;
        allow list: if isAdmin(boardId);
        allow create: if validInvitation(boardId, email, request.resource.data);
        allow update: if validInvitation(boardId, email, request.resource.data)
          || signedIn()
            && resource.data.email == request.auth.token.email
            && request.auth.token.email_verified == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedBy', 'acceptedAt'])
            && request.resource.data.acceptedBy == request.auth.uid
            && request.resource.data.acceptedAt is timestamp;
        allow delete: if isAdmin(boardId);
      }

      match /tasks/{taskId} {
        allow read: if isBoardMember(boardId);
        allow create: if canEdit(boardId)
          && validTask(boardId, taskId, request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canEdit(boardId)
          && validTask(boardId, taskId, request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if canEdit(boardId);

        match /comments/{commentId} {
          allow read: if isBoardMember(boardId);
          allow create: if canEdit(boardId)
            && request.resource.data.keys().hasOnly(['taskId', 'authorUid', 'authorName', 'authorPhotoURL', 'content', 'mentions', 'createdAt'])
            && request.resource.data.taskId == taskId
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 2000
            && request.resource.data.mentions is list
            && request.resource.data.createdAt is timestamp;
          allow update, delete: if false;
        }

        match /activity/{activityId} {
          allow read: if isBoardMember(boardId);
          allow create: if canEdit(boardId)
            && request.resource.data.taskId == taskId
            && request.resource.data.actorUid == request.auth.uid;
          allow update, delete: if false;
        }
      }

      match /activity/{activityId} {
        allow read: if isBoardMember(boardId);
        allow create: if canEdit(boardId)
          && request.resource.data.boardId == boardId
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['boardId', 'taskId', 'taskTitle', 'actorUid', 'actorName', 'type', 'message', 'read', 'createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && canEdit(request.resource.data.boardId)
        && isMember(request.resource.data.boardId, userId)
        && request.resource.data.message is string
        && request.resource.data.read == false;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if false;
    }
  }
}