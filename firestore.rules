rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function boardPath(boardId) {
      return /databases/$(database)/documents/boards/$(boardId);
    }

    function isMember(boardId) {
      return signedIn()
        && exists(boardPath(boardId))
        && get(boardPath(boardId)).data.memberIds.hasAny([request.auth.uid]);
    }

    function hasRole(boardId, roles) {
      return isMember(boardId)
        && get(boardPath(boardId)).data.members[request.auth.uid] in roles;
    }

    function isBoardOwner(boardId) {
      return hasRole(boardId, ['OWNER']);
    }

    function canEditBoard(boardId) {
      return hasRole(boardId, ['OWNER', 'EDITOR']);
    }

    function validSprint(data) {
      return data.keys().hasOnly(['name', 'goal', 'start', 'end', 'status'])
        && data.name is string
        && data.goal is string
        && data.start is string
        && data.end is string
        && data.status in ['planned', 'active', 'closed'];
    }

    function validTaskSprint(boardId, sprintId) {
      return sprintId == ''
        || (exists(/databases/$(database)/documents/boards/$(boardId)/sprints/$(sprintId))
          && get(/databases/$(database)/documents/boards/$(boardId)/sprints/$(sprintId)).data.status != 'closed');
    }

    function isLastColumn(boardId, status) {
      let columns = get(boardPath(boardId)).data.columns;
      return columns.size() > 0
        && status == columns[columns.size() - 1].id;
    }

    function validTask(data) {
      return data.boardId is string
        && data.title is string
        && data.description is string
        && data.status is string
        && data.assigneeId is string
        && data.sprintId is string
        && data.storyPoints is number
        && data.dodComplete is bool;
    }

    function validAssignee(boardId, assigneeId) {
      return assigneeId == ''
        || get(boardPath(boardId)).data.memberIds.hasAny([assigneeId]);
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;

      match /notifications/{notificationId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['text', 'taskId', 'boardId', 'read', 'at'])
          && request.resource.data.text is string
          && (request.resource.data.taskId == null || request.resource.data.taskId is string)
          && request.resource.data.boardId is string
          && request.resource.data.read == false
          && getAfter(boardPath(request.resource.data.boardId)).data.memberIds.hasAny([userId])
          && canEditBoard(request.resource.data.boardId)
          && (request.resource.data.taskId == null
            || (existsAfter(/databases/$(database)/documents/tasks/$(request.resource.data.taskId))
              && getAfter(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.boardId
                == request.resource.data.boardId));
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow delete: if false;
      }
    }

    match /boards/{boardId} {
      allow get, list: if signedIn()
        && resource.data.memberIds.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members[request.auth.uid] == 'OWNER'
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.emails[request.auth.uid] == request.auth.token.email;
      allow update: if isBoardOwner(boardId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'members', 'memberIds', 'emails', 'columns', 'dod'])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.members[request.auth.uid] == 'OWNER'
        && request.resource.data.memberIds.hasAny([request.auth.uid]);
      allow delete: if isBoardOwner(boardId);

      match /sprints/{sprintId} {
        allow read: if isMember(boardId);
        allow create: if isBoardOwner(boardId) && validSprint(request.resource.data);
        allow update: if isBoardOwner(boardId) && validSprint(request.resource.data);
        allow delete: if isBoardOwner(boardId);
      }

      match /activity/{activityId} {
        allow read: if isMember(boardId);
        allow create: if canEditBoard(boardId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string;
        allow update, delete: if false;
      }
    }

    match /tasks/{taskId} {
      allow get, list: if isMember(resource.data.boardId);
      allow create: if validTask(request.resource.data)
        && canEditBoard(request.resource.data.boardId)
        && validAssignee(request.resource.data.boardId, request.resource.data.assigneeId)
        && validTaskSprint(request.resource.data.boardId, request.resource.data.sprintId)
        && (!isLastColumn(request.resource.data.boardId, request.resource.data.status)
          || request.resource.data.dodComplete);
      allow update: if validTask(request.resource.data)
        && resource.data.boardId == request.resource.data.boardId
        && canEditBoard(resource.data.boardId)
        && validAssignee(resource.data.boardId, request.resource.data.assigneeId)
        && (request.resource.data.sprintId == resource.data.sprintId
          || validTaskSprint(resource.data.boardId, request.resource.data.sprintId))
        && (!(request.resource.data.status != resource.data.status
          && isLastColumn(resource.data.boardId, request.resource.data.status))
          || request.resource.data.dodComplete);
      allow delete: if canEditBoard(resource.data.boardId);

      match /comments/{commentId} {
        allow read: if isMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.boardId);
        allow create: if canEditBoard(get(/databases/$(database)/documents/tasks/$(taskId)).data.boardId)
          && request.resource.data.keys().hasOnly(['text', 'authorId', 'authorEmail', 'at', 'mentions'])
          && request.resource.data.text is string
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorEmail == request.auth.token.email
          && request.resource.data.mentions is list
          && get(boardPath(get(/databases/$(database)/documents/tasks/$(taskId)).data.boardId))
            .data.memberIds.hasAll(request.resource.data.mentions);
        allow update, delete: if false;
      }
    }
  }
}
